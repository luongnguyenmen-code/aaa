{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/**",
          "assets/**"
        ],
        "excludeFiles": "assets/vendor/islepilot-skin/cdn/**"
      }
    },
    {
      "src": "assets/vendor/islepilot-skin/cdn/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/cdn/skinviewer/(.*)",
      "dest": "/assets/vendor/islepilot-skin/cdn/skinviewer/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
