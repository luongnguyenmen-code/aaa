{
    "version":  2,
    "builds":  [
                   {
                       "src":  "server.js",
                       "use":  "@vercel/node"
                   },
                   {
                       "src":  "*.html",
                       "use":  "@vercel/static"
                   },
                   {
                       "src":  "assets/**",
                       "use":  "@vercel/static"
                   }
               ],
    "routes":  [
                   {
                       "src":  "/song-bac.html",
                       "dest":  "/server.js"
                   },
                   {
                       "src":  "/api/(.*)",
                       "dest":  "/server.js"
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/$1"
                   }
               ]
}