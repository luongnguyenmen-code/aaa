# Set these environment variables on your hosting platform or in the shell.
# Local .env.local then .env are loaded; hosting/shell values take precedence.
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=https://your-portal.example
ISLEPILOT_API_TOKEN=replace-with-your-new-islepilot-token

# Optional upstream base URL
ISLEPILOT_API_BASE_URL=https://islepilot.eu/api/v1

# Plinko: free non-redeemable game points only. Direct PostgreSQL connection.
PLINKO_ENABLED=false
PLINKO_DATABASE_URL=

# Portal data/config/transaction journal shared across Vercel instances.
# Use a direct PostgreSQL connection, not a transaction pooler.
PORTAL_DATABASE_URL=
# Optional persistent directory for a single Node process (copy existing JSON first).
ST25_DATA_DIR=
