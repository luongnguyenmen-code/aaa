# Set these environment variables on your hosting platform or in the shell.
# Local .env is loaded by src/core/config.js; hosting/shell values take precedence.
SESSION_SECRET=replace-with-a-long-random-secret
PUBLIC_ORIGIN=https://your-portal.example
ISLEPILOT_API_TOKEN=replace-with-your-new-islepilot-token

# Optional upstream base URL
ISLEPILOT_API_BASE_URL=https://islepilot.eu/api/v1

# Roll: use a DIRECT PostgreSQL connection URL (not a transaction pooler).
# Official Roll opens when database and session secret are configured. Set false to pause betting.
ROLL_DATABASE_URL=
ROLL_ENABLED=true
