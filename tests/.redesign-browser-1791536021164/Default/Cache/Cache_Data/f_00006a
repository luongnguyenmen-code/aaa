              <option value="Troodon">Troodon (Kẻ săn đêm độc dược)</option>
              <option value="Beipiaosaurus">Beipiaosaurus (Khủng long lông vũ)</option>
            </select>
          </div>

          <!-- Giới tính & Chế độ -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
            <div>
              <label class="form-label" style="font-size: 0.82rem; color: #94a3b8; margin-bottom: 4px; display: block;">Giới tính</label>
              <div class="btn-segment-group">
                <button type="button" class="btn-segment active" id="btn-gender-female" onclick="setGender('female')">Cái</button>
                <button type="button" class="btn-segment" id="btn-gender-male" onclick="setGender('male')">Đực</button>
              </div>
            </div>
            <div>
              <label class="form-label" style="font-size: 0.82rem; color: #94a3b8; margin-bottom: 4px; display: block;">Chế độ</label>
              <div class="btn-segment-group">
                <button type="button" class="btn-segment active" id="btn-mode-std" onclick="setSkinMode('std')">Tiêu Chuẩn</button>
                <button type="button" class="btn-segment" id="btn-mode-glitch" onclick="setSkinMode('glitch')">Glitch</button>
              </div>
            </div>
          </div>

          <!-- Biến thể & Họa tiết -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
            <div>
              <label class="form-label" style="font-size: 0.82rem; color: #94a3b8; margin-bottom: 4px; display: block;">Biến thể</label>
              <input type="number" id="skin-variation" class="form-input" value="0" min="0" max="10" style="padding: 6px 10px; font-size: 0.88rem;">
            </div>
            <div>
              <label class="form-label" style="font-size: 0.82rem; color: #94a3b8; margin-bottom: 4px; display: block;">Họa tiết (0-4)</label>
              <input type="number" id="skin-pattern-idx" class="form-input" value="0" min="0" max="4" style="padding: 6px 10px; font-size: 0.88rem;">
            </div>
          </div>

          <!-- Nhập mã & Chủ đề -->
          <div style="display: grid; grid-template-columns: 1.6fr 0.8fr; gap: 10px;">
            <div>
              <label class="form-label" style="font-size: 0.82rem; color: #94a3b8; margin-bottom: 4px; display: block;">Nhập mã skin trong game</label>
              <div style="display: flex; gap: 6px;">
                <button type="button" onclick="pasteSkinCodeFromClipboard()" class="btn btn-secondary btn-sm" style="flex: 1; font-size: 0.78rem; padding: 6px 8px; white-space: nowrap;">
                  📋 Dán mã skin
                </button>
                <button type="button" onclick="promptImportCustomCode()" class="btn btn-secondary btn-sm" style="font-size: 0.78rem; padding: 6px 10px;">
                  Nhập
                </button>
              </div>
            </div>
            <div>
              <label class="form-label" style="font-size: 0.82rem; color: #94a3b8; margin-bottom: 4px; display: block;">Chủ đề</label>
              <input type="number" id="skin-theme" class="form-input" value="0" min="0" max="10" style="padding: 6px 10px; font-size: 0.88rem;">
            </div>
          </div>
        </div>

        <!-- Color Channels Card (Màu sắc) -->
        <div class="control-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <h3 style="color: #fff; font-size: 1.15rem; margin: 0; font-weight: 700;">Màu sắc</h3>
            <div style="display: flex; gap: 6px;">
              <button type="button" class="btn-icon-sm" onclick="randomizeColors()" title="Xáo trộn màu ngẫu nhiên (bỏ qua kênh khóa)">🔀</button>
              <button type="button" class="btn-icon-sm" onclick="copySkinJson()" title="Sao chép JSON bảng màu">📋</button>
              <button type="button" class="btn-icon-sm" onclick="importSkinJson()" title="Dán mã JSON bảng màu">📥</button>
              <button type="button" class="btn-icon-sm" onclick="resetAllColors()" title="Khôi phục toàn bộ 10 màu về mặc định">🔄</button>
            </div>
          </div>

          <!-- Injected 10 Color Channels Rows Container -->
          <div id="color-channels-list">
            <!-- Rendered by JS -->
          </div>
        </div>

        <!-- Main Action Buttons -->
        <div style="margin-bottom: 20px;">
          <button onclick="handleApplySkinWithLua()" class="btn btn-primary" style="width: 100%; padding: 14px; font-weight: 800; font-size: 1.05rem; background: linear-gradient(135deg, #3b82f6, #2563eb); border: none; border-radius: 8px; box-shadow: 0 4px 18px rgba(59, 130, 246, 0.45); margin-bottom: 10px;">
            ⚡ Áp dụng trong game (10 Lúa 🌾)
          </button>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
            <button onclick="copySkinJson()" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; padding: 8px 6px;">
              📋 Sao chép JSON
            </button>
            <button onclick="downloadSkinJson()" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; padding: 8px 6px;">
              💾 Tải xuống
            </button>
            <button onclick="exportSkinCode()" class="btn btn-secondary btn-sm" style="font-size: 0.8rem; padding: 8px 6px;">
              📜 Xuất Evrima
            </button>
          </div>
        </div>

        <!-- Saved Presets Card -->
        <div class="control-card">
          <h4 style="color: #fff; font-size: 0.95rem; margin: 0 0 10px; font-weight: 700;">Preset đã lưu</h4>
          <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <input type="text" id="preset-save-name" placeholder="Tên preset mới..." class="form-input" style="padding: 6px 10px; font-size: 0.85rem;">
            <button onclick="saveCurrentPreset()" class="btn btn-secondary btn-sm" style="white-space: nowrap; font-weight: 700;">
              Lưu
            </button>
          </div>
          <div id="saved-presets-list" style="display: flex; flex-wrap: wrap; gap: 6px;">
            <!-- Dynamically injected -->
          </div>
        </div>

      </div>

    </div>

    <!-- Export Code Section Modal/Collapsible -->
    <div id="export-box" style="display: none; margin-top: 25px; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 10px;">
        <h3 style="color: #fff; font-size: 1.1rem; margin: 0;">📜 Mã Skin Code The Isle: Evrima Đã Tạo</h3>
        <button onclick="copySkinCode()" class="btn btn-secondary btn-sm" id="btn-copy-skin">
          📑 Sao Chép 1-Click
        </button>
      </div>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 10px;">
        Mở game The Isle &gt; vào Character Customization &gt; bấm nút <strong>Paste Skin Code</strong> để nạp bộ màu này vào nhân vật của bạn!
      </p>
      <textarea id="skin-code-output" style="width: 100%; height: 80px; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 6px; color: #fbbf24; font-family: monospace; font-size: 0.85rem; padding: 10px; resize: none;" readonly></textarea>
    </div>

    <!-- Kho Skin Đã Sở Hữu -->
    <section style="margin-top: 45px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 10px;">
        <div>
          <h2 style="color: #fff; font-size: 1.4rem; margin: 0 0 4px;">🎒 Kho Skin Đã Sở Hữu Của Bạn</h2>
          <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Các mẫu skin bạn đã mở khóa từ Shop hoặc trúng từ Hòm May Mắn. Có thể áp dụng ngay vào nhân vật.</p>
        </div>
        <span class="rule-badge badge-allow" id="owned-skin-count">0 Mẫu Skin</span>
      </div>

      <div id="owned-skin-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px;">
        <div style="grid-column: 1 / -1; text-align: center; padding: 30px; background: rgba(0,0,0,0.25); border-radius: 8px; color: #94a3b8;">
          Đang nạp kho skin của bạn...
        </div>
      </div>
    </section>

    <!-- Skin Shop Section (Linked Directly to IslePilot API) -->
    <section style="margin-top: 45px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 10px;">
        <div>
          <h2 style="color: #fff; font-size: 1.4rem; margin: 0 0 4px;">✨ Cửa Hàng Skin Độc Quyền ST25 (Dùng Lúa 🌾)</h2>
          <p style="color: var(--text-secondary); margin: 0; font-size: 0.85rem;">Các mẫu skin dạ quang và sự kiện đặc biệt mua trực tiếp bằng Lúa trong ví tài khoản IslePilot.</p>
        </div>
        <span class="rule-badge badge-warn" id="shop-skin-count">Đang tải...</span>
      </div>

      <div id="skin-shop-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px;">
        <!-- Injected by JS -->
      </div>
    </section>

    </div> <!-- End skin-authenticated-content -->

  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container" style="text-align: center;">
      <p>© 2026 ST25 — Trình tạo & Quản lý Skin khủng long máy chủ The Isle: Evrima Việt Nam.</p>
    </div>
  </footer>

