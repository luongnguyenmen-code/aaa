      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.88rem;
      transition: all 0.15s ease;
    }
    .btn-icon-sm:hover {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
    }
    .btn-icon-sm.locked {
      color: #f59e0b;
      border-color: #f59e0b;
